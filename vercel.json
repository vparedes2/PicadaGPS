{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": [
    "gru1"
  ],
  "functions": {
    "api/datos.ts": {
      "includeFiles": "datos/**",
      "maxDuration": 20
    }
  },
  "rewrites": [
    {
      "source": "/empresas",
      "destination": "/empresas.html"
    },
    {
      "source": "/empresa",
      "destination": "/empresas.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "empresas.picadagps.ar"
        }
      ],
      "destination": "/empresas.html"
    },
    {
      "source": "/((?!api/|assets/|demo/|compartir[^/]*\\.jpg|icono|manifest\\.webmanifest|sw\\.js|workbox-|registerSW\\.js).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/empresas.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
